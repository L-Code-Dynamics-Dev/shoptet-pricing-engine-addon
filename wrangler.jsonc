{
  "name": "lcode-shoptet-pricing-dev",
  "main": "apps/api/src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "SYNC_MODE": "off"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lcode-shoptet-pricing-dev",
      "database_id": "e30f946d-5e2d-4985-9c3a-fada524d9edf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_ASSETS",
      "bucket_name": "lcode-shoptet-pricing-releases"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_COORDINATOR",
        "class_name": "ShopSyncCoordinator",
        "script_name": "lcode-shoptet-sync-dev"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
